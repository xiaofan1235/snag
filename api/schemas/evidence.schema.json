{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snag.dev/schemas/evidence.schema.json",
  "title": "Finding",
  "description": "Finding/Evidence/Verification 契约（§4.1 findings/evidence、§43.5 FindingState/VerificationVerdict、§36 验证）。Agent 自报不能直接 REPORTABLE（§4.3 #7）；证据须含规定角色且同 Run（§4.3 #6）。",
  "type": "object",
  "required": ["title", "vulnerability_type", "severity", "state", "evidence"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "vulnerability_type": { "type": "string", "minLength": 1 },
    "severity": { "type": "string", "enum": ["info", "low", "medium", "high", "critical"] },
    "state": {
      "type": "string",
      "enum": ["CANDIDATE", "NEEDS_EVIDENCE", "REJECTED", "CONFIRMED", "TRIAGED", "REPORTABLE"]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["evidence_id", "role"],
        "properties": {
          "evidence_id": { "type": "string", "minLength": 1 },
          "role": {
            "type": "string",
            "enum": ["baseline", "variant", "ownership", "impact", "replay", "screenshot", "cleanup", "counterevidence"]
          },
          "byte_start": { "type": "integer", "minimum": 0 },
          "byte_end": { "type": "integer", "minimum": 0 },
          "content_sha256": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "verification": {
      "type": "object",
      "required": ["verdict"],
      "properties": {
        "verdict": { "type": "string", "enum": ["CONFIRMED", "REJECTED", "UNABLE_TO_VERIFY"] },
        "verifier_kind": { "type": "string" },
        "model_profile": { "type": "string" }
      }
    }
  },
  "additionalProperties": true
}
