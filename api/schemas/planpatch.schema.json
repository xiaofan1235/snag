{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snag.dev/schemas/planpatch.schema.json",
  "title": "PlanPatch",
  "description": "Strategist 输出（§6.3）。模型只能输出计划补丁，不能直接改库。op 限定 M0 清单。",
  "type": "object",
  "required": ["snapshot_revision", "operations"],
  "properties": {
    "snapshot_revision": { "type": "integer", "minimum": 0 },
    "epoch_reason": { "type": "string" },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "M0 有意只约束 op 枚举，不约束各 op 的载荷字段（Q-10）；实现各 op 时用 if/then 或 oneOf 按 op 收口载荷，防止载荷漂移。PlanPatch 经 PlanCompiler 应用，非 digest 锚，故宽松风险低。",
        "required": ["op"],
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "upsert_hypothesis",
              "create_job",
              "cancel_pending_job",
              "reprioritize_job",
              "mark_hypothesis_blocked",
              "request_approval",
              "request_reframe",
              "close_epoch"
            ]
          }
        }
      }
    }
  },
  "additionalProperties": false
}
